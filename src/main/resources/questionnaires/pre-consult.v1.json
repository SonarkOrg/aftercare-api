  "rules": [
    {
      "linkId": "WILL_ATTEND",
      "operator": "equals-false",
      "outcome": {
        "type": "NEEDS_REVIEW",
        "message": {
          "fr": "Le patient pourrait ne pas se présenter — appeler pour replanifier",
          "en": "Patient may not attend — call to reschedule"
